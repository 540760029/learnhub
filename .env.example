# ============ LearnHub 环境变量（复制成 .env 后按需修改） ============
# 会话签名 + API Key 加密用的主密钥。生产环境务必改成随机长字符串！
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(48))"
LEARNHUB_SECRET=dev-only-change-me-in-production

# 数据库地址。默认用本地 SQLite；迁移到 Postgres 时直接换这一行即可：
# LEARNHUB_DB_URL=postgresql+psycopg://user:pass@host:5432/learnhub
LEARNHUB_DB_URL=

# 平台默认 API Key
#   ⚠️ 平台 Key 现在由【管理员登录后台 →「🔑 平台 AI Key」页面】上传，
#      加密存入数据库，对全体用户生效（教师/学生每日限次，管理员不限次）。
#      下面这个环境变量只作为「容器化部署的初始化兜底」：数据库里没配置时才会用它。
LEARNHUB_PLATFORM_API_KEY=
LEARNHUB_DEFAULT_PROVIDER=deepseek

# 教师/学生使用平台 Key 时的每日出题套数（管理员可在后台随时改，这里只是初始默认）
LEARNHUB_DAILY_AI_LIMIT=3

# 首次启动是否写入演示账号与课程（1 写入，0 不写）
LEARNHUB_SEED=1

# 会话有效期（秒），默认 7 天
LEARNHUB_TOKEN_TTL=604800
