# ============ LearnHub 环境变量模板 ============
# 用法：复制为 .env 后按需修改；或直接运行  python setup_env.py  自动生成。
# .env 已在 .gitignore 中，绝不会被提交。

# ---------------------------------------------------------------------------
# 【必改】会话签名 + API Key 加密主密钥
# ---------------------------------------------------------------------------
# ⚠️ 下面这个默认值是公开的、绝对不能用于生产！任何拿到它的人都能：
#      * 伪造任意用户的登录令牌（含管理员）
#      * 解密数据库里已保存的所有 API Key
# 生成随机值：
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
# 或者直接跑  python setup_env.py  （推荐，它会自动生成并写入 .env）
#
# ⚠️ 一旦上线就不要随意更换：换掉后已加密的用户 API Key 会解不开，学生需要重新填写。
LEARNHUB_SECRET=dev-only-change-me-in-production

# ---------------------------------------------------------------------------
# 数据库地址
# ---------------------------------------------------------------------------
# 留空 = 本地 SQLite（data/learnhub.db），适合单机/演示。
# 迁移到 Postgres（推荐生产使用，改这一行即可，模型都是通用类型）：
#   LEARNHUB_DB_URL=postgresql+psycopg://user:pass@host:5432/learnhub
# Supabase 连接串示例（注意用 Session pooler 端口）：
#   LEARNHUB_DB_URL=postgresql+psycopg://postgres.xxxx:密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
LEARNHUB_DB_URL=

# ---------------------------------------------------------------------------
# 平台默认 AI Key
# ---------------------------------------------------------------------------
# 正常做法：用管理员账号登录后台 →「🔑 平台 AI Key」页面上传，
#           Key 会加密存库、对全体用户生效（教师/学生限次，管理员不限）。
# 这里的环境变量只是「容器化部署时的初始化兜底」：数据库里没配置时才用它。
LEARNHUB_PLATFORM_API_KEY=
LEARNHUB_DEFAULT_PROVIDER=deepseek

# 教师/学生使用平台 Key 时的每日出题套数（管理员可在后台随时调整）
LEARNHUB_DAILY_AI_LIMIT=3

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# 首次启动是否写入演示账号与课程（1 写入，0 不写）
# ⚠️ 正式上线请设为 0；若已写入，记得改掉演示账号密码或删除它们
LEARNHUB_SEED=1

# 会话有效期（秒），默认 7 天
LEARNHUB_TOKEN_TTL=604800
